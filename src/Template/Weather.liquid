                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <circle cx="60" cy="60" r="24"></circle>
                                <line x1="60" y1="10" x2="60" y2="25"></line>
                                <line x1="60" y1="95" x2="60" y2="110"></line>
                                <line x1="10" y1="60" x2="25" y2="60"></line>
                                <line x1="95" y1="60" x2="110" y2="60"></line>
                                <line x1="25" y1="25" x2="36" y2="36"></line>
                                <line x1="84" y1="84" x2="95" y2="95"></line>
                                <line x1="25" y1="95" x2="36" y2="84"></line>
                                <line x1="84" y1="36" x2="95" y2="25"></line>
                            </svg>

                        {% when 1 %}
