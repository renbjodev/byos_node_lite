<style>
    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background: #fff;
        color: #000;
        font-family: Arial, Helvetica, sans-serif;
    }

    .weather-screen {
        width: 100vw;
        height: 100vh;
        padding: 34px 46px 28px;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    /* HEADER */

    .weather-header {
        height: 58px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .weather-title {
        font-size: 30px;
        line-height: 1;
        font-weight: 700;
    }

    .weather-updated {
        font-size: 18px;
        line-height: 1;
        white-space: nowrap;
    }

    /* TODAY */

    .today {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: 53% 47%;
        align-items: stretch;
        padding: 18px 0 26px;
    }

    .today-left {
        display: flex;
        align-items: center;
        justify-content: center;
        padding-right: 38px;
    }

    .current-weather {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 34px;
    }

    .current-copy {
        text-align: center;
        min-width: 190px;
    }

    .current-temp {
        font-size: 116px;
        font-weight: 700;
        line-height: 0.85;
        letter-spacing: -5px;
    }

    .current-condition {
        margin-top: 22px;
        font-size: 27px;
        line-height: 1.1;
    }

    .current-icon {
        width: 150px;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        color: #000;
    }

    .current-icon svg {
        display: block;
        width: 150px !important;
        height: 150px !important;
        max-width: 150px;
        max-height: 150px;
    }

    /* DETAILS */

    .today-right {
        display: flex;
        align-items: center;
        border-left: 3px solid #000;
        padding-left: 42px;
    }

    .details {
        width: 100%;
        display: grid;
        grid-template-columns: 178px 1fr;
        row-gap: 18px;
        align-items: baseline;
        font-size: 28px;
        line-height: 1;
    }

    .detail-label {
        font-weight: 700;
        white-space: nowrap;
    }

    .detail-value {
        font-weight: 400;
        white-space: nowrap;
    }

    /* FORECAST */

    .forecast {
        height: 250px;
        border-top: 4px solid #000;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        padding-top: 18px;
    }

    .forecast-day {
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        text-align: center;
        padding: 0 12px 4px;
        border-right: 2px solid #000;
    }

    .forecast-day:last-child {
        border-right: none;
    }

    .forecast-name {
        font-size: 25px;
        font-weight: 700;
        line-height: 1;
    }

    .forecast-icon {
        width: 82px;
        height: 82px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        color: #000;
        margin: 2px 0;
    }

    .forecast-icon svg {
        display: block;
        width: 82px !important;
        height: 82px !important;
        max-width: 82px;
        max-height: 82px;
    }

    .forecast-temp {
        font-size: 25px;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
    }

    .forecast-rain {
        font-size: 18px;
        line-height: 1;
        white-space: nowrap;
    }
</style>


<div class="weather-screen">

    <header class="weather-header">

        <div class="weather-title">
            {{ weather.location }} · I DAG
        </div>

        <div class="weather-updated">
            Sist oppdatert: {{ time }}
        </div>

    </header>


    <main class="today">

        <section class="today-left">

            <div class="current-weather">

                <div class="current-copy">

                    <div class="current-temp">
                        {{ weather.current.temperature }}°
                    </div>

                    <div class="current-condition">
                        {{ weather.current.weatherLabel }}
                    </div>

                </div>


                <div class="current-icon">
                    {{ weather.current.iconSvg }}
                </div>

            </div>

        </section>


        <section class="today-right">

            <div class="details">

                <div class="detail-label">
                    Maks
                </div>

                <div class="detail-value">
                    {{ weather.today.maxTemp }} °C
                </div>


                <div class="detail-label">
                    Min
                </div>

                <div class="detail-value">
                    {{ weather.today.minTemp }} °C
                </div>


                <div class="detail-label">
                    Føles som
                </div>

                <div class="detail-value">
                    {{ weather.current.apparentTemperature }} °C
                </div>


                <div class="detail-label">
                    Vind
                </div>

                <div class="detail-value">
                    {{ weather.current.windSpeed }} m/s
                </div>


                <div class="detail-label">
                    Nedbør
                </div>

                <div class="detail-value">
                    {{ weather.today.precipitationMm }} mm
                </div>

            </div>

        </section>

    </main>


    <section class="forecast">

        {% for day in weather.forecast %}

            <article class="forecast-day">

                <div class="forecast-name">
                    {{ day.dayName }}
                </div>


                <div class="forecast-icon">
                    {{ day.iconSvg }}
                </div>


                <div class="forecast-temp">
                    {{ day.maxTemp }}° / {{ day.minTemp }}°
                </div>


                <div class="forecast-rain">
                    {{ day.precipitationMm }} mm
                </div>

            </article>

        {% endfor %}

    </section>

</div>
