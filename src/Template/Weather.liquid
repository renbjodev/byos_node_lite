<style>
    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background: #fff;
        color: #000;
        font-family: Arial, Helvetica, sans-serif;
    }

    .weather-screen {
        width: 100vw;
        height: 100vh;
        padding: 34px 46px 28px;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    /* HEADER */

    .weather-header {
        height: 58px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .weather-title {
        font-size: 30px;
        line-height: 1;
        font-weight: 700;
    }

    .weather-updated {
        font-size: 18px;
        line-height: 1;
        white-space: nowrap;
    }

    /* TODAY */

    .today {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: 53% 47%;
        align-items: stretch;
        padding: 18px 0 26px;
    }

    .today-left {
        display: flex;
        align-items: center;
        justify-content: center;
        padding-right: 38px;
    }

    .current-weather {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 34px;
    }

    .current-copy {
        text-align: center;
        min-width: 190px;
    }

    .current-temp {
        font-size: 116px;
        font-weight: 700;
        line-height: 0.85;
        letter-spacing: -5px;
    }

    .current-condition {
        margin-top: 22px;
        font-size: 27px;
        line-height: 1.1;
    }

    .current-icon {
        width: 150px;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .current-icon img {
        width: 150px;
        height: 150px;
        object-fit: contain;
        display: block;
    }

    /* DETAILS */

    .today-right {
        display: flex;
        align-items: center;
        border-left: 3px solid #000;
        padding-left: 42px;
    }

    .details {
        width: 100%;
        display: grid;
        grid-template-columns: 178px 1fr;
        row-gap: 18px;
        align-items: baseline;
        font-size: 28px;
        line-height: 1;
    }

    .detail-label {
        font-weight: 700;
        white-space: nowrap;
    }

    .detail-value {
        white-space: nowrap;
        font-weight: 400;
    }

    /* FORECAST */

    .forecast {
        height: 250px;
        border-top: 4px solid #000;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        padding-top: 18px;
    }

    .forecast-day {
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        text-align: center;
        padding: 0 12px 4px;
        border-right: 2px solid #000;
    }

    .forecast-day:last-child {
        border-right: none;
    }

    .forecast-name {
        font-size: 25px;
        font-weight: 700;
        line-height: 1;
    }

    .forecast-icon {
        width: 82px;
        height: 82px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 2px 0;
    }

    .forecast-icon img {
        width: 82px;
        height: 82px;
        object-fit: contain;
        display: block;
    }

    .forecast-temp {
        font-size: 25px;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
    }

    .forecast-rain {
        font-size: 18px;
        line-height: 1;
        white-space: nowrap;
    }
</style>


<div class="weather-screen">

    <header class="weather-header">

        <div class="weather-title">
            {{ weather.location }} · I DAG
        </div>

        <div class="weather-updated">
            Sist oppdatert: {{ time }}
        </div>

    </header>


    <main class="today">

        <section class="today-left">

            <div class="current-weather">

                <div class="current-copy">

                    <div class="current-temp">
                        {{ weather.current.temperature }}°
                    </div>

                    <div class="current-condition">
                        {{ weather.current.weatherLabel }}
                    </div>

                </div>


                {% assign code = weather.current.weatherCode %}
                {% assign icon = "overcast" %}

                {% if code == 0 %}
                    {% assign icon = "clear-day" %}

                {% elsif code == 1 %}
                    {% assign icon = "partly-cloudy-day" %}

                {% elsif code == 2 %}
                    {% assign icon = "overcast" %}

                {% elsif code == 3 %}
                    {% assign icon = "overcast" %}

                {% elsif code == 45 or code == 48 %}
                    {% assign icon = "fog-day" %}

                {% elsif code == 51 or code == 53 or code == 55 or code == 56 or code == 57 %}
                    {% assign icon = "drizzle" %}

                {% elsif code == 61 %}
                    {% assign icon = "drizzle" %}

                {% elsif code == 63 %}
                    {% assign icon = "rain" %}

                {% elsif code == 65 or code == 66 or code == 67 %}
                    {% assign icon = "extreme-rain" %}

                {% elsif code == 71 or code == 73 or code == 75 or code == 77 %}
                    {% assign icon = "snow" %}

                {% elsif code == 80 %}
                    {% assign icon = "partly-cloudy-day-rain" %}

                {% elsif code == 81 %}
                    {% assign icon = "rain" %}

                {% elsif code == 82 %}
                    {% assign icon = "extreme-rain" %}

                {% elsif code == 85 or code == 86 %}
                    {% assign icon = "snow" %}

                {% elsif code == 95 or code == 96 or code == 99 %}
                    {% assign icon = "thunderstorms-day-rain" %}
                {% endif %}


                <div class="current-icon">
                    <img
                        src="https://cdn.meteocons.com/latest/svg-static/monochrome/{{ icon }}.svg"
                        alt="{{ weather.current.weatherLabel }}"
                    >
                </div>

            </div>

        </section>


        <section class="today-right">

            <div class="details">

                <div class="detail-label">Maks</div>
                <div class="detail-value">
                    {{ weather.today.maxTemp }} °C
                </div>

                <div class="detail-label">Min</div>
                <div class="detail-value">
                    {{ weather.today.minTemp }} °C
                </div>

                <div class="detail-label">Føles som</div>
                <div class="detail-value">
                    {{ weather.current.apparentTemperature }} °C
                </div>

                <div class="detail-label">Vind</div>
                <div class="detail-value">
                    {{ weather.current.windSpeed }} m/s
                </div>

                <div class="detail-label">Nedbør</div>
                <div class="detail-value">
                    {{ weather.today.precipitationMm }} mm
                </div>

            </div>

        </section>

    </main>


    <section class="forecast">

        {% for day in weather.forecast %}

            {% assign code = day.weatherCode %}
            {% assign icon = "overcast" %}

            {% if code == 0 %}
                {% assign icon = "clear-day" %}

            {% elsif code == 1 %}
                {% assign icon = "partly-cloudy-day" %}

            {% elsif code == 2 %}
                {% assign icon = "overcast" %}

            {% elsif code == 3 %}
                {% assign icon = "overcast" %}

            {% elsif code == 45 or code == 48 %}
                {% assign icon = "fog-day" %}

            {% elsif code == 51 or code == 53 or code == 55 or code == 56 or code == 57 %}
                {% assign icon = "drizzle" %}

            {% elsif code == 61 %}
                {% assign icon = "drizzle" %}

            {% elsif code == 63 %}
                {% assign icon = "rain" %}

            {% elsif code == 65 or code == 66 or code == 67 %}
                {% assign icon = "extreme-rain" %}

            {% elsif code == 71 or code == 73 or code == 75 or code == 77 %}
                {% assign icon = "snow" %}

            {% elsif code == 80 %}
                {% assign icon = "partly-cloudy-day-rain" %}

            {% elsif code == 81 %}
                {% assign icon = "rain" %}

            {% elsif code == 82 %}
                {% assign icon = "extreme-rain" %}

            {% elsif code == 85 or code == 86 %}
                {% assign icon = "snow" %}

            {% elsif code == 95 or code == 96 or code == 99 %}
                {% assign icon = "thunderstorms-day-rain" %}
            {% endif %}


            <article class="forecast-day">

                <div class="forecast-name">
                    {{ day.dayName }}
                </div>

                <div class="forecast-icon">
                    <img
                        src="https://cdn.meteocons.com/latest/svg-static/monochrome/{{ icon }}.svg"
                        alt="{{ day.weatherLabel }}"
                    >
                </div>

                <div class="forecast-temp">
                    {{ day.maxTemp }}° / {{ day.minTemp }}°
                </div>

                <div class="forecast-rain">
                    {{ day.precipitationMm }} mm
                </div>

            </article>

        {% endfor %}

    </section>

</div>
