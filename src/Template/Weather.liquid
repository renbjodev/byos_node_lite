                                <line x1="95" y1="60" x2="110" y2="60"></line>
                                <line x1="25" y1="25" x2="36" y2="36"></line>
                                <line x1="84" y1="84" x2="95" y2="95"></line>
                                <line x1="25" y1="95" x2="36" y2="84"></line>
                                <line x1="84" y1="36" x2="95" y2="25"></line>
                            </svg>

                        {% when 1 or 2 %}
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <circle cx="40" cy="38" r="17"></circle>
                                <line x1="40" y1="11" x2="40" y2="18"></line>
                                <line x1="15" y1="38" x2="22" y2="38"></line>
                                <line x1="58" y1="38" x2="65" y2="38"></line>
                                <path d="M26 94
                                         C18 94 13 87 13 79
                                         C13 70 20 63 29 63
                                         C35 51 46 45 59 45
                                         C74 45 85 55 88 69
                                         C98 70 106 78 106 88
                                         C106 99 98 105 87 105
                                         H31
                                         C21 105 13 101 13 94"></path>
                            </svg>

                        {% when 3 %}
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <path d="M24 91
                                         C15 91 10 84 10 75
                                         C10 65 18 57 28 57
                                         C34 42 47 34 62 34
                                         C80 34 94 47 96 64
                                         C106 66 113 74 113 85
                                         C113 97 104 105 92 105
                                         H29
                                         C18 105 10 100 10 91"></path>
                            </svg>

                        {% when 45 or 48 %}
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <line x1="18" y1="38" x2="102" y2="38"></line>
                                <line x1="28" y1="55" x2="92" y2="55"></line>
                                <line x1="15" y1="72" x2="105" y2="72"></line>
                                <line x1="31" y1="89" x2="89" y2="89"></line>
                            </svg>

                        {% when 51 or 53 or 55 or 56 or 57 or 61 or 63 or 65 or 66 or 67 or 80 or 81 or 82 %}
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <path d="M22 68
                                         C14 68 10 61 10 53
                                         C10 44 18 36 27 36
                                         C33 23 44 17 58 17
                                         C74 17 86 28 88 42
                                         C99 43 107 51 107 62
                                         C107 72 99 79 88 79
                                         H28
                                         C18 79 10 75 10 68"></path>
                                <line x1="35" y1="89" x2="29" y2="103"></line>
                                <line x1="59" y1="89" x2="53" y2="103"></line>
                                <line x1="83" y1="89" x2="77" y2="103"></line>
                            </svg>

                        {% when 71 or 73 or 75 or 77 or 85 or 86 %}
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <path d="M22 65
                                         C14 65 10 58 10 50
                                         C10 41 18 33 27 33
                                         C33 21 44 15 58 15
                                         C74 15 86 26 88 40
                                         C99 41 107 49 107 60
                                         C107 70 99 77 88 77
                                         H28
                                         C18 77 10 73 10 65"></path>
                                <line x1="33" y1="89" x2="33" y2="105"></line>
                                <line x1="25" y1="97" x2="41" y2="97"></line>
                                <line x1="60" y1="89" x2="60" y2="105"></line>
                                <line x1="52" y1="97" x2="68" y2="97"></line>
                                <line x1="87" y1="89" x2="87" y2="105"></line>
                                <line x1="79" y1="97" x2="95" y2="97"></line>
                            </svg>

                        {% when 95 or 96 or 99 %}
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <path d="M22 63
                                         C14 63 10 56 10 48
                                         C10 39 18 31 27 31
                                         C33 19 44 13 58 13
                                         C74 13 86 24 88 38
                                         C99 39 107 47 107 58
                                         C107 68 99 75 88 75
                                         H28
                                         C18 75 10 71 10 63"></path>
                                <polyline points="62,78 48,98 61,98 52,113 77,89 63,89 72,78"></polyline>
                            </svg>

                        {% else %}
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <path d="M24 91
                                         C15 91 10 84 10 75
                                         C10 65 18 57 28 57
                                         C34 42 47 34 62 34
                                         C80 34 94 47 96 64
                                         C106 66 113 74 113 85
                                         C113 97 104 105 92 105
                                         H29
                                         C18 105 10 100 10 91"></path>
                            </svg>

                    {% endcase %}

                </div>


                <div class="forecast-temp">
                    {{ day.maxTemp }}° / {{ day.minTemp }}°
                </div>

                <div class="forecast-rain">
    {{ day.precipitationMm }} mm
</div>

            </article>

        {% endfor %}

    </section>

</div>
