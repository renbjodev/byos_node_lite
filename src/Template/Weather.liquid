<style>
.weather-screen {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 28px 34px;
    display: flex;
    flex-direction: column;
    font-family: sans-serif;
    color: black;
    background: white;
}

.weather-today {
    height: 64%;
    display: flex;
    flex-direction: column;
}

.weather-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 20px;
}

.weather-place {
    font-size: 28px;
    font-weight: 700;
}

.weather-time {
    font-size: 20px;
}

.weather-main {
    flex: 1;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
}

.weather-now {
    display: flex;
    align-items: center;
    gap: 28px;
}

.weather-icon-large {
    font-size: 116px;
    line-height: 1;
}

.weather-temp {
    font-size: 112px;
    font-weight: 700;
    line-height: 0.9;
}

.weather-condition {
    margin-top: 14px;
    font-size: 26px;
}

.weather-details {
    border-left: 3px solid black;
    padding-left: 38px;
    font-size: 27px;
    line-height: 1.65;
}

.weather-details strong {
    display: inline-block;
    min-width: 130px;
}

.weather-forecast {
    height: 36%;
    border-top: 4px solid black;
    padding-top: 18px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
}

.forecast-day {
    text-align: center;
    border-right: 2px solid black;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 4px 10px 8px;
}

.forecast-day:last-child {
    border-right: none;
}

.forecast-name {
    font-size: 25px;
    font-weight: 700;
}

.forecast-icon {
    font-size: 51px;
    line-height: 1;
}

.forecast-temp {
    font-size: 26px;
    font-weight: 700;
}

.forecast-rain {
    font-size: 20px;
}
</style>

<div class="weather-screen">

    <section class="weather-today">

        <div class="weather-heading">
            <div class="weather-place">{{ weather.location }} · I DAG</div>
            <div class="weather-time">{{ time }}</div>
        </div>

        <div class="weather-main">

            <div class="weather-now">
                <div class="weather-icon-large">
                    {{ weather.current.icon }}
                </div>

                <div>
                    <div class="weather-temp">
                        {{ weather.current.temperature }}°
                    </div>

                    <div class="weather-condition">
                        {{ weather.current.weatherLabel }}
                    </div>
                </div>
            </div>

            <div class="weather-details">
                <div>
                    <strong>Maks</strong>
                    {{ weather.today.maxTemp }} °C
                </div>

                <div>
                    <strong>Min</strong>
                    {{ weather.today.minTemp }} °C
                </div>

                <div>
                    <strong>Føles</strong>
                    {{ weather.current.apparentTemperature }} °C
                </div>

                <div>
                    <strong>Vind</strong>
                    {{ weather.current.windSpeed }} m/s
                </div>

                <div>
                    <strong>Nedbør</strong>
                    {{ weather.today.rainChance }} %
                </div>
            </div>

        </div>

    </section>

    <section class="weather-forecast">

        {% for day in weather.forecast %}

        <div class="forecast-day">

            <div class="forecast-name">
                {{ day.dayName }}
            </div>

            <div class="forecast-icon">
                {{ day.icon }}
            </div>

            <div class="forecast-temp">
                {{ day.maxTemp }}° / {{ day.minTemp }}°
            </div>

            <div class="forecast-rain">
                Regn {{ day.rainChance }}%
            </div>

        </div>

        {% endfor %}

    </section>

</div>
