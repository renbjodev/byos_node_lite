<style>
    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background: #fff;
        color: #000;
        font-family: Arial, Helvetica, sans-serif;
    }

    .weather-screen {
        width: 100vw;
        height: 100vh;
        padding: 34px 46px 28px;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    /* ---------------------------------------------------------
       HEADER
    --------------------------------------------------------- */

    .weather-header {
        height: 58px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .weather-title {
        font-size: 30px;
        line-height: 1;
        font-weight: 700;
        letter-spacing: 0.2px;
    }

    .weather-updated {
        font-size: 18px;
        line-height: 1;
        white-space: nowrap;
    }

    /* ---------------------------------------------------------
       TODAY
    --------------------------------------------------------- */

    .today {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: 53% 47%;
        align-items: stretch;
        padding: 18px 0 26px;
    }

    .today-left {
        display: flex;
        align-items: center;
        justify-content: center;
        padding-right: 38px;
    }

    .current-weather {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 34px;
    }

    .current-copy {
        text-align: center;
        min-width: 190px;
    }

    .current-temp {
        font-size: 116px;
        font-weight: 700;
        line-height: 0.85;
        letter-spacing: -5px;
    }

    .current-condition {
        margin-top: 22px;
        font-size: 27px;
        line-height: 1.1;
    }

    .current-icon {
        width: 150px;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .current-icon svg {
        width: 142px;
        height: 142px;
    }

    /* ---------------------------------------------------------
       DETAILS
    --------------------------------------------------------- */

    .today-right {
        display: flex;
        align-items: center;
        border-left: 3px solid #000;
        padding-left: 42px;
    }

    .details {
        width: 100%;
        display: grid;
        grid-template-columns: 178px 1fr;
        row-gap: 18px;
        align-items: baseline;
        font-size: 28px;
        line-height: 1;
    }

    .detail-label {
        font-weight: 700;
        white-space: nowrap;
    }

    .detail-value {
        white-space: nowrap;
        font-weight: 400;
    }

    /* ---------------------------------------------------------
       FORECAST
    --------------------------------------------------------- */

    .forecast {
        height: 250px;
        border-top: 4px solid #000;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        padding-top: 18px;
    }

    .forecast-day {
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        text-align: center;
        padding: 0 12px 4px;
        border-right: 2px solid #000;
    }

    .forecast-day:last-child {
        border-right: none;
    }

    .forecast-name {
        font-size: 25px;
        font-weight: 700;
        line-height: 1;
    }

    .forecast-icon {
        width: 76px;
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 6px 0;
    }

    .forecast-icon svg {
        width: 74px;
        height: 74px;
    }

    .forecast-temp {
        font-size: 25px;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
    }

    .forecast-rain {
        font-size: 18px;
        line-height: 1;
        white-space: nowrap;
    }

    /* ---------------------------------------------------------
       SVG WEATHER ICONS
    --------------------------------------------------------- */

    .weather-svg {
        fill: none;
        stroke: #000;
        stroke-width: 7;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .forecast-icon .weather-svg {
        stroke-width: 6;
    }
</style>


<div class="weather-screen">

    <!-- HEADER -->
    <header class="weather-header">
        <div class="weather-title">
            {{ weather.location }} · I DAG
        </div>

        <div class="weather-updated">
            Sist oppdatert: {{ time }}
        </div>
    </header>


    <!-- TODAY -->
    <main class="today">

        <section class="today-left">
            <div class="current-weather">

                <div class="current-copy">
                    <div class="current-temp">
                        {{ weather.current.temperature }}°
                    </div>

                    <div class="current-condition">
                        {{ weather.current.weatherLabel }}
                    </div>
                </div>


                <div class="current-icon">

                    {% case weather.current.weatherCode %}

