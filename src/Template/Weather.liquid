                                <line x1="18" y1="42" x2="27" y2="42"></line>
                                <line x1="67" y1="42" x2="76" y2="42"></line>
                                <line x1="26" y1="21" x2="32" y2="27"></line>
                                <line x1="62" y1="27" x2="68" y2="21"></line>
                                <path d="M30 91
                                         C23 91 18 85 18 77
                                         C18 68 25 61 34 61
                                         C39 49 49 43 61 43
                                         C75 43 86 53 88 66
                                         C97 67 104 75 104 84
                                         C104 94 96 101 86 101
                                         H34
                                         C25 101 18 97 18 91"></path>
                            </svg>

                        {% when 2 %}
                            <!-- PARTLY CLOUDY -->
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <circle cx="42" cy="38" r="18"></circle>
                                <line x1="42" y1="10" x2="42" y2="18"></line>
                                <line x1="15" y1="38" x2="23" y2="38"></line>
                                <line x1="61" y1="38" x2="69" y2="38"></line>
                                <path d="M25 94
                                         C17 94 12 87 12 79
                                         C12 70 20 62 29 62
                                         C35 49 46 43 59 43
                                         C74 43 86 54 88 68
                                         C99 69 107 77 107 88
                                         C107 99 99 106 87 106
                                         H31
                                         C20 106 12 101 12 94"></path>
                            </svg>

                        {% when 3 %}
                            <!-- CLOUDY -->
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <path d="M24 91
                                         C15 91 10 84 10 75
                                         C10 65 18 57 28 57
                                         C34 42 47 34 62 34
                                         C80 34 94 47 96 64
                                         C106 66 113 74 113 85
                                         C113 97 104 105 92 105
                                         H29
                                         C18 105 10 100 10 91"></path>
                            </svg>

                        {% when 45 or 48 %}
                            <!-- FOG -->
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <line x1="18" y1="38" x2="102" y2="38"></line>
                                <line x1="28" y1="55" x2="92" y2="55"></line>
                                <line x1="15" y1="72" x2="105" y2="72"></line>
                                <line x1="31" y1="89" x2="89" y2="89"></line>
                            </svg>

                        {% when 51 or 53 or 55 or 56 or 57 or 61 or 63 or 65 or 66 or 67 or 80 or 81 or 82 %}
                            <!-- RAIN -->
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <path d="M22 68
                                         C14 68 10 61 10 53
                                         C10 44 18 36 27 36
                                         C33 23 44 17 58 17
                                         C74 17 86 28 88 42
                                         C99 43 107 51 107 62
                                         C107 72 99 79 88 79
                                         H28
                                         C18 79 10 75 10 68"></path>
                                <line x1="35" y1="89" x2="29" y2="103"></line>
                                <line x1="59" y1="89" x2="53" y2="103"></line>
                                <line x1="83" y1="89" x2="77" y2="103"></line>
                            </svg>

                        {% when 71 or 73 or 75 or 77 or 85 or 86 %}
                            <!-- SNOW -->
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <path d="M22 65
                                         C14 65 10 58 10 50
                                         C10 41 18 33 27 33
                                         C33 21 44 15 58 15
                                         C74 15 86 26 88 40
                                         C99 41 107 49 107 60
                                         C107 70 99 77 88 77
                                         H28
                                         C18 77 10 73 10 65"></path>
                                <line x1="33" y1="89" x2="33" y2="105"></line>
                                <line x1="25" y1="97" x2="41" y2="97"></line>

                                <line x1="60" y1="89" x2="60" y2="105"></line>
                                <line x1="52" y1="97" x2="68" y2="97"></line>

                                <line x1="87" y1="89" x2="87" y2="105"></line>
                                <line x1="79" y1="97" x2="95" y2="97"></line>
                            </svg>

                        {% when 95 or 96 or 99 %}
                            <!-- THUNDER -->
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <path d="M22 63
                                         C14 63 10 56 10 48
                                         C10 39 18 31 27 31
                                         C33 19 44 13 58 13
                                         C74 13 86 24 88 38
                                         C99 39 107 47 107 58
                                         C107 68 99 75 88 75
                                         H28
                                         C18 75 10 71 10 63"></path>
                                <polyline points="62,78 48,98 61,98 52,113 77,89 63,89 72,78"></polyline>
                            </svg>

                        {% else %}
                            <!-- FALLBACK CLOUD -->
                            <svg viewBox="0 0 120 120" class="weather-svg">
                                <path d="M24 91
                                         C15 91 10 84 10 75
                                         C10 65 18 57 28 57
                                         C34 42 47 34 62 34
                                         C80 34 94 47 96 64
                                         C106 66 113 74 113 85
                                         C113 97 104 105 92 105
                                         H29
                                         C18 105 10 100 10 91"></path>
                            </svg>

                    {% endcase %}

                </div>

            </div>
        </section>


        <section class="today-right">

            <div class="details">

                <div class="detail-label">Maks</div>
                <div class="detail-value">{{ weather.today.maxTemp }} °C</div>

                <div class="detail-label">Min</div>
                <div class="detail-value">{{ weather.today.minTemp }} °C</div>

                <div class="detail-label">Føles som</div>
                <div class="detail-value">{{ weather.current.apparentTemperature }} °C</div>

                <div class="detail-label">Vind</div>
                <div class="detail-value">{{ weather.current.windSpeed }} m/s</div>

                <div class="detail-label">Nedbør</div>
<div class="detail-value">{{ weather.today.precipitationMm }} mm</div>

            </div>

        </section>

    </main>


    <!-- 5 DAY FORECAST -->
    <section class="forecast">

        {% for day in weather.forecast %}

            <article class="forecast-day">

                <div class="forecast-name">
                    {{ day.dayName }}
                </div>


                <div class="forecast-icon">

                    {% case day.weatherCode %}

                        {% when 0 %}
